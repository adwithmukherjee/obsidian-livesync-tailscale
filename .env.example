# run ./scripts/bootstrap.sh to generate this
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=replace-with-a-long-random-password
COUCHDB_DATABASE=obsidiannotes
COUCHDB_PORT=5984
BACKUP_RETENTION_DAYS=30

# optional supernote copy
SUPERNOTE_NOTE_DIR=/path/to/supernote_data/account/Supernote/Note
OBSIDIAN_VAULT_DIR=/path/to/Obsidian/Notes
SUPERNOTE_COPY_INTERVAL=300
